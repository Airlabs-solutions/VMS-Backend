NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/vms?replicaSet=rs0&directConnection=true
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
FIELD_ENCRYPTION_KEY=replace-with-a-long-random-string
FIELD_HMAC_KEY=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
SMS_PROVIDER=log
SMS_SENDER=VMS
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
RATE_LIMIT_DISABLED=false
# Client ID from Google Cloud. It ends with .apps.googleusercontent.com. Do not put the client secret here.
GOOGLE_CLIENT_ID=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SEED_DEMO=true
