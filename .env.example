# Application Environment: local | staging | production
APP_ENV=local
NODE_ENV=development
PORT=5000

# MongoDB Replica Set URI
MONGODB_URI=mongodb://127.0.0.1:27017/vms?replicaSet=rs0

# Cryptographic Secrets (minimum 32 characters, never commit real secrets)
JWT_ACCESS_SECRET=dev-jwt-access-secret-minimum-32-chars-long
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-minimum-32-chars-long
FIELD_ENCRYPTION_KEY=dev-field-encryption-key-minimum-32-chars
FIELD_HMAC_KEY=dev-field-hmac-key-minimum-32-chars-long

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false

# Redis Configuration (BullMQ queues, rate limiting, and caching)
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Background Worker Settings
QUEUE_CONCURRENCY=5
RUN_WORKER=false

# SMS Provider: log | unifonic | taqnyat | msegat
SMS_PROVIDER=log
SMS_SENDER=VMS
SMS_API_KEY=
SMS_API_URL=
SMS_WEBHOOK_SECRET=

# Object Storage Driver: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# S3 / MinIO Configuration (when STORAGE_DRIVER=s3)
S3_BUCKET=vms-documents
S3_REGION=me-central-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Security & Limits
RATE_LIMIT_DISABLED=false

# Super Admin Sign-in & Gmail Code delivery (optional in local dev)
GOOGLE_CLIENT_ID=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Demo Data Seeding
SEED_DEMO=false
